    "Private. Describe the problem and attach screenshots and a diagnostic report. Only the LoopKit development team can see it." : {
      "comment" : "Report a problem option detail: submit an issue report to the developers",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privé. Beschrijf het probleem en voeg schermafbeeldingen en een diagnostisch rapport toe. Alleen het LoopKit-ontwikkelteam kan dit zien."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat. Descrieți problema și atașați capturi de ecran și un raport de diagnosticare. Doar echipa de dezvoltare LoopKit o poate vedea."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私密。请描述问题，并附上截图和诊断报告。只有LoopKit开发团队才能查看。"
          }
        }
      }
    },
    "Public. For bugs you can describe without any personal or health data." : {
      "comment" : "Report a problem option detail: open the public GitHub issues page",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
