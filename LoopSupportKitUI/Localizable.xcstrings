    "View Diagnostic Report" : {
      "comment" : "Button to view the diagnostic report attached to an issue report",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat diagnostisch rapport zien"
          }
        },
        "ro" : {
          "stringUnit" : {
