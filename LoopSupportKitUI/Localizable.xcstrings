    },
    "Reports go to the LoopKit development team and are visible only to them. Your IP address is used only to limit how often reports can be sent and is never stored." : {
      "comment" : "Privacy footer for issue reports",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen worden naar het LoopKit-ontwikkelteam gestuurd en zijn alleen voor hen zichtbaar. Je IP-adres wordt alleen gebruikt om te beperken hoe vaak je een melding kunt versturen en wordt nooit opgeslagen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapoartele sunt transmise echipei de dezvoltare LoopKit și sunt vizibile numai pentru aceasta. Adresa dumneavoastră IP este utilizată doar pentru a limita frecvența cu care pot fi trimise rapoartele și nu este niciodată stocată."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告会发送给 LoopKit 开发团队，只有他们才能查看。您的 IP 地址仅用于限制报告发送频率，绝不会被存储。"
          }
        }
      }
    },
