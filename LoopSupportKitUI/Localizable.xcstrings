            "value" : "提交 Bug 报告"
          }
        }
      }
    },
    "Thank you. Your report ID is %1$@. Mention it if you discuss the problem on Zulip or GitHub." : {
      "comment" : "Message after an issue report was sent (1: report ID)",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt. Je rapport-ID is %1$@. Vermeld dit als je het probleem op Zulip of GitHub bespreekt."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulțumesc. Identificatorul raportului dumneavoastră este %1$@. Menționați acest lucru dacă discutați problema pe Zulip sau GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢。您的报告 ID 是 %1$@ 。如果您在 Zulip 或 GitHub 上讨论此问题，请提及该 ID。"
          }
        }
      }
    },
    "The report is too large. Try fewer or smaller screenshots." : {
      "comment" : "Issue report error when the upload is too large",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze melding is te groot. Probeer minder tekst of minder screenshots."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportul este prea voluminos. Încercați să includeți mai puține capturi de ecran sau unele mai mici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该报告文件过大。请尝试减少截图数量或缩小截图尺寸。"
          }
        }
      }
    },
    "The report won't include your name, contact details or anything else that identifies you." : {
      "comment" : "Footer for an anonymous issue report",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het rapport worden je naam, contactgegevens of andere gegevens waarmee je kunt worden geïdentificeerd, niet vermeld."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportul nu va conține numele dumneavoastră, datele de contact sau orice alt element care v-ar putea identifica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告中不会包含您的姓名、联系方式或任何其他可以识别您身份的信息。"
          }
        }
      }
    },
    "The server couldn't accept the report (%1$d %2$@)." : {
      "comment" : "Issue report error with HTTP status (1) and reason (2)",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
