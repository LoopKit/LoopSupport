            "state" : "translated",
            "value" : "请填写以下任意一项，以便开发人员与您联系。"
          }
        }
      }
    },
    "GitHub Username" : {
      "comment" : "Issue report contact GitHub placeholder",
      "localizations" : {
        "nl" : {
