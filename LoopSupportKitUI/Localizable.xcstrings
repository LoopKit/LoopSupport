    "Fill in any of these so developers can follow up with you." : {
      "comment" : "Footer for issue report contact details",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul een van deze contactgegevens in, zodat de ontwikkelaars contact met je kunnen opnemen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completați oricare dintre acestea pentru ca dezvoltatorii să vă poată contacta ulterior."
          }
        },
        "zh-Hans" : {
