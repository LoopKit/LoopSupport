    },
    "Too many reports have been sent from this network recently. Please try again later." : {
      "comment" : "Issue report error when rate limited",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn de laatste tijd te veel meldingen verzonden via dit netwerk. Probeer het later nog eens."
